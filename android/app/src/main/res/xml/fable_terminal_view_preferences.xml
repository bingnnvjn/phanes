<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="view"
        app:title="@string/fable_terminal_view_view_header">

        <SeekBarPreference
            app:defaultValue="12"
            app:key="fontsize"
            android:max="24"
            app:min="8"
            app:showSeekBarValue="true"
            app:summary="@string/fable_terminal_view_font_size_summary"
            app:title="@string/fable_terminal_view_font_size_title" />

        <SwitchPreferenceCompat
            app:key="terminal_margin_adjustment"
            app:summaryOff="@string/fable_terminal_view_terminal_margin_adjustment_off"
            app:summaryOn="@string/fable_terminal_view_terminal_margin_adjustment_on"
            app:title="@string/fable_terminal_view_terminal_margin_adjustment_title" />

    </PreferenceCategory>

</PreferenceScreen>

# 第三方预编译资产（.a/头文件/字体，校验和见 libghostty/README.md 与 docs/build-inputs.md）
/libghostty/*
!/libghostty/README.md

# 下载的工具链压缩包
/build-tools_r30.0.3-linux.zip

# 日志
*.log

# 调查下载物（字体/PTY 捕获，不进 git）
.font-check/

# 本机 agent 工具（pi-crew）运行时目录，非 Fable 内容
# 保留忽略规则以免 .crew/ 运行时状态污染 git status
/.crew/
/.crew
!.crew/artifacts/
!.crew/graphs/
!.crew/artifacts/.gitkeep
!.crew/graphs/.gitkeep
